{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NarrativeGlossaryEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "term",
    "definition",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "term": {
      "type": "string",
      "minLength": 1
    },
    "definition": {
      "type": "string",
      "minLength": 20
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "verified",
        "deprecated"
      ]
    }
  }
}