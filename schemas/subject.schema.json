{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GastronomicSubject",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "summary",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string"
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersededBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification": {
      "type": "object",
      "required": [
        "verifiedOn",
        "method",
        "independentSourceRefs",
        "note"
      ],
      "properties": {
        "verifiedOn": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "independentSourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}