{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GastronomicRelationship",
  "type": "object",
  "required": [
    "id",
    "from",
    "to",
    "type",
    "period",
    "certainty",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "from": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "period": {
      "type": "object",
      "required": [
        "start",
        "end",
        "precision"
      ],
      "properties": {
        "start": {
          "type": "integer"
        },
        "end": {
          "type": "integer"
        },
        "precision": {
          "type": "string"
        },
        "display": {
          "type": "string"
        }
      }
    },
    "certainty": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string"
    }
  }
}