{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GastronomicOccurrence",
  "type": "object",
  "required": [
    "id",
    "subjectRef",
    "placeRef",
    "period",
    "occurrenceType",
    "evidenceType",
    "certainty",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "subjectRef": {
      "type": "string"
    },
    "placeRef": {
      "type": "string"
    },
    "period": {
      "type": "object",
      "required": [
        "start",
        "end",
        "precision"
      ],
      "properties": {
        "start": {
          "type": "integer"
        },
        "end": {
          "type": "integer"
        },
        "precision": {
          "type": "string"
        },
        "display": {
          "type": "string"
        }
      }
    },
    "occurrenceType": {
      "type": "string"
    },
    "evidenceType": {
      "type": "string"
    },
    "certainty": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string"
    },
    "contextRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "developmentRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersededBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification": {
      "type": "object",
      "required": [
        "verifiedOn",
        "method",
        "independentSourceRefs",
        "note"
      ],
      "properties": {
        "verifiedOn": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "independentSourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dispute": {
      "type": "object",
      "required": [
        "question",
        "positions"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "positions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "summary",
              "sourceRefs"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "sourceRefs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "editorialNote": {
          "type": "string"
        }
      }
    }
  }
}