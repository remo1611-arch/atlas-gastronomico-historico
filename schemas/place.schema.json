{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Place",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "point": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "status": {
      "type": "string"
    }
  }
}